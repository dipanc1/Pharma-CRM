# Supabase Configuration
# Get these values from your Supabase project dashboard
REACT_APP_SUPABASE_URL=your_supabase_project_url
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key
REACT_APP_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Direct Postgres connection — used ONLY by the Node scripts in database/
# (npm run schema:dump, npm run backup) to read the live schema.
# Supabase dashboard -> Settings -> Database -> Connection string -> URI
#
# Deliberately has NO REACT_APP_ prefix. Create React App inlines every
# REACT_APP_ variable into the public browser bundle, and this URL contains
# your database password.
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
REACT_APP_GEMINI_API_KEY=your_gemini_api_key
